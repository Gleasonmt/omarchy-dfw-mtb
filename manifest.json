{
  "schemaVersion": 1,
  "id": "gleasonmt.dfw-mtb",
  "name": "DFW MTB Trail Hub",
  "version": "0.1.1",
  "author": "Gleasonmt",
  "license": "MIT",
  "description": "Dallas–Fort Worth mountain bike trail status in your bar: your favorite trails at a glance, every trail's conditions a click away, and a notification when one opens or closes. From DFW MTB Trail Hub, by the person who runs it.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "DFW MTB Trail Hub",
    "description": "Which DFW mountain bike trails are open; click for every trail's status.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "barMode": "favorites",
      "alerts": "favorites",
      "sort": "nearest",
      "unit": "mi",
      "favorites": []
    },
    "schema": [
      {
        "key": "barMode",
        "type": "enum",
        "label": "Show in bar",
        "options": [
          "favorites",
          "count",
          "nearest"
        ],
        "defaultValue": "favorites",
        "description": "favorites: how many of your favorite trails are open (all trails until you pick some); count: how many trails are open; nearest: your nearest trail's status."
      },
      {
        "key": "alerts",
        "type": "enum",
        "label": "Alerts",
        "options": [
          "favorites",
          "all",
          "off"
        ],
        "defaultValue": "favorites",
        "description": "A notification when a trail opens, closes or goes to caution: for your favorites, any trail, or none."
      },
      {
        "key": "sort",
        "type": "enum",
        "label": "Sort trails",
        "options": [
          "nearest",
          "name",
          "status"
        ],
        "defaultValue": "nearest",
        "description": "Order of the trail list: nearest your Weather location, by name, or open first."
      },
      {
        "key": "unit",
        "type": "enum",
        "label": "Unit",
        "options": [
          "mi",
          "km"
        ],
        "defaultValue": "mi"
      },
      {
        "key": "favorites",
        "type": "multiselect",
        "label": "Favorite trails",
        "defaultValue": [],
        "description": "Your trails. Easiest to set by right-clicking a trail in the panel (or its star); new trails on the site work there too.",
        "noSelectionText": "No favorites",
        "placeholderText": "Search trails...",
        "emptyText": "No trails",
